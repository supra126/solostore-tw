# 複製成 .env 後填入真值。注意：檔名必須是 .env（非 .env.local）。
# Supabase 專案設定 → API 可找到 URL 與 anon key。
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Postgres connection string（Drizzle 用）。
# 部署到 serverless/Vercel 時，app 建議用 Supabase「Transaction pooler」(port 6543)，
# 搭配 lib/db/drizzle.ts 的 prepare:false，避免連線耗盡（EMAXCONNSESSION）：
#   postgresql://postgres.<ref>:[password]@aws-0-<region>.pooler.supabase.com:6543/postgres
# migration/seed 這類長駐單一程序可改用 direct 連線（db.<ref>.supabase.co:5432）或 session pooler(5432)。
POSTGRES_URL=postgresql://postgres.<ref>:[password]@aws-0-<region>.pooler.supabase.com:6543/postgres
# 伺服端專用（繞過 RLS，勿進前端）。用 Supabase 新版 secret key（sb_secret_...）；舊版 service_role key 亦相容。
SUPABASE_SECRET_KEY=
# 品牌設定（可選；留空則用 config/site.ts 的預設值）
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_DESCRIPTION=
NEXT_PUBLIC_SITE_URL=
PAYMENT_PROVIDER=
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_ENV=
APP_URL=
